#!/bin/bash
set -u
CONFIG="/etc/default/xserve-arm-control"
if [ -r "$CONFIG" ]; then
    set -a
    . "$CONFIG"
    set +a
fi
API="${XARMC_API:-http://127.0.0.1:5000}"
choice=$(kdialog --title "Xserve ARM Monitor" --menu "Choose an action:" \
    web "Open web dashboard" \
    desktop "Open desktop application" \
    both "Open both applications" \
    stop "Stop background service" \
    start "Start background service") || exit 0

start_web() {
    if ! systemctl is-active --quiet xserve-arm-control; then
        kdialog --error "The Xserve ARM Monitor background service is not running. Choose Start background service first."
        return 1
    fi
    xdg-open "$API" >/dev/null 2>&1 &
}

start_desktop() {
    if ! pgrep -f '[/]usr/lib/xserve-arm-control/desktop/main.py' >/dev/null; then
        nohup /usr/bin/python3 /usr/lib/xserve-arm-control/desktop/main.py >/tmp/xserve-arm-control-desktop.log 2>&1 </dev/null &
    fi
}

stop_service() {
    if ! systemctl is-active --quiet xserve-arm-control; then
        kdialog --msgbox "The Xserve ARM Monitor background service is already stopped."
        return 0
    fi
    if kdialog --warningyesno "Stop the Xserve ARM Monitor background service? The web dashboard and desktop application will lose live data."; then
        pkexec /usr/bin/systemctl stop xserve-arm-control.service
    fi
}

start_service() {
    if systemctl is-active --quiet xserve-arm-control; then
        kdialog --msgbox "The Xserve ARM Monitor background service is already running."
        return 0
    fi
    pkexec /usr/bin/systemctl start xserve-arm-control.service
}

case "$choice" in
    web) start_web ;;
    desktop) start_desktop ;;
    both) start_web && start_desktop ;;
    stop) stop_service ;;
    start) start_service ;;
esac
